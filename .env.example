# Copy to .env.local (git-ignored) and fill in real values. Never commit real values.

# Used by the AI advisor / skin-coach chat features.
ANTHROPIC_API_KEY=

# Shopify Storefront API — public-safe token (not a secret like the Admin API
# token), used both at build time to generate the product catalogue and in
# the browser to create real Shopify carts/checkouts.
# Get these from: Shopify Admin > Settings > Apps and sales channels >
# Develop apps > (create/select an app) > API credentials > Storefront API.
NEXT_PUBLIC_SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
NEXT_PUBLIC_SHOPIFY_STOREFRONT_ACCESS_TOKEN=
# Optional — defaults to 2025-10 if unset.
NEXT_PUBLIC_SHOPIFY_API_VERSION=

# Supabase — server-only. SERVER-ONLY: never prefix these with NEXT_PUBLIC_,
# the service role key bypasses row-level security. Used by src/app/api/auth/*
# for real accounts + the points ledger. Get the service role key from:
# Supabase Dashboard > Project Settings > API > service_role secret.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Random secret used to sign the session cookie. Generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Shopify webhook signing secret — from the same custom app as the Storefront
# token, API credentials page ("API secret key" / Client secret). Used to
# verify orders/paid, orders/cancelled, refunds/create webhooks that credit
# and reverse loyalty points at src/app/api/webhooks/shopify/route.ts.
SHOPIFY_WEBHOOK_SECRET=

# Resend — server-only. Sends the email OTP login code (src/app/api/auth/
# email-otp/*). Get the key from: https://resend.com/api-keys. Without it,
# the send endpoint still works but returns the code in the API response
# instead of emailing it (dev-mode fallback).
RESEND_API_KEY=
# Must be a sender address on a domain verified in Resend. Defaults to the
# Resend sandbox address (only delivers to your own Resend account email).
RESEND_FROM_EMAIL=

# Keeps the product catalogue (stock/price) fresh between deploys. The
# catalogue is only ever written at build time (scripts/fetch-products.js
# via the `prebuild` script) — Vercel's production filesystem is read-only
# at runtime, so refreshing it means triggering a new build. Vercel Cron
# (see vercel.json) calls src/app/api/cron/refresh-catalogue on a schedule,
# which forwards to this Deploy Hook to start that rebuild.
# 1. Vercel Dashboard > Project > Settings > Git > Deploy Hooks > create one
#    for the `main` branch, paste its URL here.
# 2. Vercel Dashboard > Project > Settings > Environment Variables > add
#    CRON_SECRET (any random string, e.g. the same generator as SESSION_SECRET
#    above) — Vercel Cron sends this automatically as a bearer token, so the
#    route can reject calls that don't come from Vercel's own scheduler.
# Note: Vercel's Hobby plan rejects the *entire deployment* if a cron
# schedule fires more than once/day (not a silent downgrade) — vercel.json
# is set to once/day (03:00 UTC) for that reason. Only bump the frequency
# if this project is on a Pro plan.
VERCEL_DEPLOY_HOOK_URL=
CRON_SECRET=

# Sign in with Apple — needs a paid Apple Developer account. Create a
# Services ID (this is APPLE_CLIENT_ID) under Certificates, Identifiers &
# Profiles > Identifiers, enable "Sign in with Apple", and register this
# redirect URI: https://<your-domain>/api/auth/apple/callback. Then create a
# "Sign in with Apple" key under Keys — download the .p8 file once (Apple
# only shows it once), that's APPLE_PRIVATE_KEY (paste the whole file,
# newlines become literal \n), and its 10-character ID is APPLE_KEY_ID.
# APPLE_TEAM_ID is your 10-character Team ID, shown on the Membership page.
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
# Set to "true" once the four vars above are all set, to show the Apple
# button on the login page (kept server-controlled rather than inferring
# "configured" client-side, since the actual secrets never reach the browser).
NEXT_PUBLIC_APPLE_SIGNIN_ENABLED=
