# Copy to .env.local (git-ignored) and fill in real values. Never commit real values.

# Used by the AI advisor / skin-coach chat features.
ANTHROPIC_API_KEY=

# Shopify Storefront API — public-safe token (not a secret like the Admin API
# token), used both at build time to generate the product catalogue and in
# the browser to create real Shopify carts/checkouts.
# Get these from: Shopify Admin > Settings > Apps and sales channels >
# Develop apps > (create/select an app) > API credentials > Storefront API.
NEXT_PUBLIC_SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
NEXT_PUBLIC_SHOPIFY_STOREFRONT_ACCESS_TOKEN=
# Optional — defaults to 2025-10 if unset.
NEXT_PUBLIC_SHOPIFY_API_VERSION=

# Supabase — server-only. SERVER-ONLY: never prefix these with NEXT_PUBLIC_,
# the service role key bypasses row-level security. Used by src/app/api/auth/*
# for real accounts + the points ledger. Get the service role key from:
# Supabase Dashboard > Project Settings > API > service_role secret.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Random secret used to sign the session cookie. Generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Shopify webhook signing secret — from the same custom app as the Storefront
# token, API credentials page ("API secret key" / Client secret). Used to
# verify orders/paid, orders/cancelled, refunds/create webhooks that credit
# and reverse loyalty points at src/app/api/webhooks/shopify/route.ts.
SHOPIFY_WEBHOOK_SECRET=

# Resend — server-only. Sends the email OTP login code (src/app/api/auth/
# email-otp/*). Get the key from: https://resend.com/api-keys. Without it,
# the send endpoint still works but returns the code in the API response
# instead of emailing it (dev-mode fallback).
RESEND_API_KEY=
# Must be a sender address on a domain verified in Resend. Defaults to the
# Resend sandbox address (only delivers to your own Resend account email).
RESEND_FROM_EMAIL=

# Keeps the product catalogue (stock/price) fresh between deploys. The
# catalogue is only ever written at build time (scripts/fetch-products.js
# via the `prebuild` script) — Vercel's production filesystem is read-only
# at runtime, so refreshing it means triggering a new build. Vercel Cron
# (see vercel.json) calls src/app/api/cron/refresh-catalogue on a schedule,
# which forwards to this Deploy Hook to start that rebuild.
# 1. Vercel Dashboard > Project > Settings > Git > Deploy Hooks > create one
#    for the `main` branch, paste its URL here.
# 2. Vercel Dashboard > Project > Settings > Environment Variables > add
#    CRON_SECRET (any random string, e.g. the same generator as SESSION_SECRET
#    above) — Vercel Cron sends this automatically as a bearer token, so the
#    route can reject calls that don't come from Vercel's own scheduler.
# Note: Vercel's Hobby plan rejects the *entire deployment* if a cron
# schedule fires more than once/day (not a silent downgrade) — vercel.json
# is set to once/day (03:00 UTC) for that reason. Only bump the frequency
# if this project is on a Pro plan.
VERCEL_DEPLOY_HOOK_URL=
CRON_SECRET=

# Sign in with Apple — needs a paid Apple Developer account. Create a
# Services ID (this is APPLE_CLIENT_ID) under Certificates, Identifiers &
# Profiles > Identifiers, enable "Sign in with Apple", and register this
# redirect URI: https://<your-domain>/api/auth/apple/callback. Then create a
# "Sign in with Apple" key under Keys — download the .p8 file once (Apple
# only shows it once), that's APPLE_PRIVATE_KEY (paste the whole file,
# newlines become literal \n), and its 10-character ID is APPLE_KEY_ID.
# APPLE_TEAM_ID is your 10-character Team ID, shown on the Membership page.
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
# Set to "true" once the four vars above are all set, to show the Apple
# button on the login page (kept server-controlled rather than inferring
# "configured" client-side, since the actual secrets never reach the browser).
NEXT_PUBLIC_APPLE_SIGNIN_ENABLED=

# LINE Login — developers.line.biz/console > (Provider) > create a "LINE
# Login" channel. LINE_CHANNEL_ID/SECRET are the channel's Basic settings
# values; add this redirect URI under LINE Login settings:
# https://<your-domain>/api/auth/line/callback
LINE_CHANNEL_ID=
LINE_CHANNEL_SECRET=

# LIFF (LINE Front-end Framework) — under the SAME LINE Login channel above,
# LINE Developers Console > LIFF tab > Add. Endpoint URL: https://<your-
# domain>/liff (must be HTTPS). Enable the "openid" and "profile" scopes so
# liff.getIDToken() returns a usable token. Size: Full or Tall recommended
# for the chat/account pages. This ID is public (shipped to the browser to
# call liff.init()) — it identifies the LIFF app, it isn't a secret.
NEXT_PUBLIC_LIFF_ID=

# Google Sign-In — console.cloud.google.com > APIs & Services > Credentials >
# Create Credentials > OAuth client ID > Application type: Web application.
# Add this Authorized redirect URI: https://<your-domain>/api/auth/google/callback.
# GOOGLE_CLIENT_ID and GOOGLE_CLIENT_SECRET come from that client's page.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Set to "true" once both vars above are set, to show the Google button.
NEXT_PUBLIC_GOOGLE_SIGNIN_ENABLED=

# 2C2P direct API credentials for real recurring "Subscribe & Save" billing
# (src/lib/2c2p.ts) — a SEPARATE merchant credential pair from whatever
# gateway Shopify's own hosted checkout uses, requested directly from 2C2P
# (not Shopify) with Recurring Payment Plan (RPP) enabled on the account.
# Until both are set, the site falls back to the interim "buy the term
# upfront with a discount code" behavior automatically — no other code
# changes needed once these are filled in.
TWOC2P_MERCHANT_ID=
TWOC2P_SECRET_KEY=
# "production" or unset/anything else = sandbox (sandbox-pgw.2c2p.com).
TWOC2P_ENV=
# Subscribe & Save is gated separately from one-time checkout: it also needs
# Recurring Payment Plan provisioned on the 2C2P account AND the RSA keys
# below (without them a customer can subscribe but never cancel). Set to
# "enabled" only once both have been exercised against the live account;
# anything else leaves every subscribe surface on the discount-code
# fallback while normal checkout keeps working.
TWOC2P_SUBSCRIPTIONS=

# Separate RSA key exchange needed only for the "unsubscribe" flow
# (Recurring Payment Maintenance API, different auth scheme from the two
# vars above). Generate a keypair (openssl or scripts/generate-2c2p-keys.js),
# then in 2C2P's merchant portal: upload the PUBLIC key at Account >
# Options > Merchant Public Keys, and download 2C2P's own public key from
# Account > Options > 2C2P Public Keys. Paste full PEM contents below —
# for Vercel, use \n for newlines same as the Firebase/Apple keys above.
TWOC2P_MERCHANT_PRIVATE_KEY=
TWOC2P_PUBLIC_KEY=

# ClickUp — "ส่งต่อเป็นเคส" in the unified inbox turns a conversation into a
# tracked task (complaints, returns — anything needing follow-up after the chat
# ends). Until both are set the button reports that it isn't configured rather
# than silently doing nothing.
# Token: ClickUp > Settings > Apps > API Token (personal token, used verbatim
# in the Authorization header, no "Bearer" prefix).
# List ID: the smoothlife.com list in Team Space.
CLICKUP_API_TOKEN=
CLICKUP_LIST_ID=

# LINE Messaging API — only needed for the LINE OA Rich Menu (the button grid
# under the chat). This is a DIFFERENT channel from the LINE Login one above:
# a Rich Menu belongs to a Messaging API channel, i.e. a LINE Official Account.
# Create/enable it at manager.line.biz > Settings > Messaging API, choosing the
# SAME provider as the LIFF app ("SmoothLife") — LINE issues userId per
# provider, so a different one would split each customer into two accounts.
# Then: LINE Developers Console > that channel > Messaging API > Channel access
# token. Until this is set, /admin/line-rich-menu explains what is missing
# instead of failing.
LINE_MESSAGING_ACCESS_TOKEN=
